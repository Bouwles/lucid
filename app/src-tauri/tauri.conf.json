{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LUCID",
  "version": "0.2.0",
  "identifier": "com.paulnercessian.lucid",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LUCID",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#171a20"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*",
        "img-src": "'self' data: blob: http://127.0.0.1:*",
        "media-src": "'self' data: blob: http://127.0.0.1:*"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Paul Nercessian",
    "copyright": "Copyright Paul Nercessian",
    "category": "Game",
    "shortDescription": "Play games and their dreams",
    "longDescription": "LUCID plays neural dreams of games: a diffusion world model imagines each frame from the last few frames and your key presses.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/lucid-engine"],
    "resources": {
      "resources/models/": "resources/models/"
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
